    "# ===== ENDOTHELIAL BERNOULLI STATE COMPOSITION OVER TIME =====\n",
    "# Fraction of endothelial cells assigned to each Bernoulli state, by timepoint.\n",
    "endo_state = all_data[(all_data[\"cell_type\"] == \"Endothelial\") & all_data[\"has_reads\"] & (all_data[\"bmm\"] >= 0)].copy()\n",
    "endo_state[\"timepoint\"] = endo_state[IMAGE_KEY].map(timepoint_of)\n",
    "\n",
    "state_counts = (endo_state.groupby([\"timepoint\", \"bmm\"]).size()\n",
    "                .unstack(fill_value=0)\n",
    "                .reindex(TIME_ORDER, fill_value=0))\n",
    "state_frac = state_counts.div(state_counts.sum(axis=1), axis=0).fillna(0)\n",
    "\n",
    "# Make labels readable: map each bmm state to its saved cluster label, if present.\n",
    "state_labels = {state: cluster_name_of.get(state, str(state)) for state in state_frac.columns}\n",
    "state_frac.columns = [state_labels.get(c, str(c)) for c in state_frac.columns]\n",
    "\n",
    "print(\"% of endothelial cells in each Bernoulli state, by timepoint:\")\n",
    "print(state_frac.round(3))\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(max(8, 0.9 * len(state_frac.columns) + 3), 5))\n",
    "state_frac.T.plot(kind=\"bar\", ax=ax, cmap=\"tab10\")\n",
    "ax.set_xlabel(\"Bernoulli state\")\n",
    "ax.set_ylabel(\"fraction of endothelial cells\")\n",
    "ax.set_title(\"Endothelial Bernoulli-state composition over time\")\n",
    "ax.legend(title=\"timepoint\", bbox_to_anchor=(1.02, 1), loc=\"upper left\")\n",
    "ax.grid(axis=\"y\", alpha=0.3)\n",
    "plt.tight_layout(); plt.show()\n"
   ]
